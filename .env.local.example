# Supabase project: HIG Biz Operation
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Data Sync. Without these the app runs; only syncing is inert.
# The service account key, as JSON or base64 of it. Read-only by scope.
GOOGLE_SERVICE_ACCOUNT_JSON=
# A secret key (sb_secret_...) or the legacy service_role JWT. Bypasses row
# level security, so server-side only: never prefix this NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY is accepted as an alias. Every sync needs this, Run now
# included.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string. On Vercel, set CRON_SECRET instead.
SYNC_TICK_SECRET=
